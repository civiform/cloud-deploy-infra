#! /usr/bin/env bash

# DOC: Run terraform validate, and terraform test where a suite exists, against
# every Terraform root under cloud/.
# Initializes without a backend and without cloud credentials, so this runs anywhere.
#
# Modules are validated through the roots that call them rather than on their
# own: standalone they don't pin a provider version and resolve to the latest
# release, which produces failures that don't reflect a real deploy.
#
# A root has a test suite when it holds *.tftest.hcl files or a tests/
# directory. Suites are plan-only against mocked providers, so they need no
# credentials either. Every root runs even after an earlier one fails; the exit
# status is non-zero if any init, validate, or test failed.

set -euo pipefail

if ! which terraform >/dev/null; then
  echo "Can not find the terraform binary. Please install Terraform first."
  exit 1
fi

roots=(
  cloud/aws/modules/ecs_fargate_service/tests/external_lb
  cloud/aws/templates/aws_oidc
  cloud/aws/templates/aws_oidc/setup
  cloud/azure
  cloud/azure/templates/azure_saml_ses
  cloud/gcp/templates/gke_autopilot
  cloud/gcp/templates/gke_autopilot/setup
  cloud/shared/modules/cloudflare_dns
)

has_tests() {
  compgen -G "${1}/*.tftest.hcl" >/dev/null || [[ -d "${1}/tests" ]]
}

failed=0

for dir in "${roots[@]}"; do
  echo "==> ${dir}"

  if ! terraform -chdir="${dir}" init -backend=false -input=false >/dev/null; then
    echo "init failed: ${dir}"
    failed=1
    continue
  fi

  if ! terraform -chdir="${dir}" validate; then
    failed=1
  fi

  if has_tests "${dir}"; then
    if ! terraform -chdir="${dir}" test; then
      echo "test failed: ${dir}"
      failed=1
    fi
  fi
done

exit "${failed}"
