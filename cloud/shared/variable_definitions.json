{
  "CIVIFORM_APPLICANT_AUTH_PROTOCOL": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "enum",
    "values": ["oidc", "saml"]
  },
  "CIVIFORM_CLOUD_PROVIDER": {
    "required": true,
    "secret": false,
    "tfvar": false,
    "type": "enum",
    "values": ["gcp", "azure", "aws"]
  },
  "CIVIFORM_MODE": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "enum",
    "values": ["prod", "staging", "test"]
  },
  "SKIP_CONFIRMATIONS": {
    "required": false,
    "secret": false,
    "tfvar": false,
    "type": "bool"
  },
  "USE_LOCAL_BACKEND": {
    "required": false,
    "secret": false,
    "tfvar": false,
    "type": "bool"
  },
  "CUSTOM_HOSTNAME": {
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "EMAIL_PROVIDER": {
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "SENDER_EMAIL_ADDRESS": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "STAGING_APPLICANT_NOTIFICATION_MAILING_LIST": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "STAGING_PROGRAM_ADMIN_NOTIFICATION_MAILING_LIST": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "STAGING_TI_NOTIFICATION_MAILING_LIST": {
    "required": true,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "TERRAFORM_TEMPLATE_DIR": {
    "required": true,
    "secret": false,
    "tfvar": false,
    "type": "string"
  },
  "ENABLE_CLOUDFLARE_DNS": {
    "description": "Optional. Whether to configure Cloudflare DNS for this deployment. Only done in new deployments. Requires using AWS cloud provider.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "bool"
  },
  "CLOUDFLARE_API_TOKEN_SECRET_ARN": {
    "description": "ARN of a AWS Secrets Manager secret containing a Cloudflare API Token. Required if ENABLE_CLOUDFLARE_DNS is true.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "CLOUDFLARE_ZONE_ID": {
    "description": "Cloudflare Zone ID. Required if ENABLE_CLOUDFLARE_DNS is true.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "CLOUDFLARE_RECORD_NAME": {
    "description": "DNS record name of CNAME to create in Cloudflare. Required if ENABLE_CLOUDFLARE_DNS is true.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "string"
  },
  "CLOUDFLARE_PROXIED": {
    "description": "Optional. Whether to proxy traffic for the CNAME record in Cloudflare. Default is true.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "bool"
  },
  "CLOUDFLARE_TTL": {
    "description": "Optional. TTL for the Cloudflare DNS record in seconds (1 for automatic). Default is 1.",
    "required": false,
    "secret": false,
    "tfvar": true,
    "type": "integer"
  }
}
